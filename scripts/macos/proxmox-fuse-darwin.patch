+/// A `kqueue` with a user event used to "wake up" the reactor.
+#[cfg(target_os = "macos")]
+struct Kqueue {
+    kq: RawFd,
+}
+
+/// `ident` of the user event used to shut down the reactor.
+#[cfg(target_os = "macos")]
+const FINISH_IDENT: usize = 1;
+
+#[cfg(target_os = "macos")]
+impl Drop for Kqueue {
+    fn drop(&mut self) {
+        if self.kq >= 0 {
+            let _ = unsafe { libc::close(self.kq) };
+        }
+    }
+}
+
+#[cfg(target_os = "macos")]
+impl Kqueue {
+    /// Create a new instance.
+    fn new() -> io::Result<Self> {
+        let kq = unsafe { libc::kqueue() };
+        if kq < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let this = Kqueue { kq };
+
+        if unsafe { libc::fcntl(kq, libc::F_SETFD, libc::FD_CLOEXEC) } < 0 {
+            return Err(io::Error::last_os_error());
+        }
+
+        this.change(
+            FINISH_IDENT,
+            libc::EVFILT_USER,
+            libc::EV_ADD | libc::EV_CLEAR,
+            0,
+        )?;
+
+        Ok(this)
+    }
+
+    /// Wake up and shutdown the reactor.
+    fn signal_finish(&self) -> io::Result<()> {
+        self.change(FINISH_IDENT, libc::EVFILT_USER, 0, libc::NOTE_TRIGGER)
+    }
+
+    /// Register or trigger an event.
+    fn change(&self, ident: usize, filter: i16, flags: u16, fflags: u32) -> io::Result<()> {
+        let event = libc::kevent {
+            ident,
+            filter,
+            flags,
+            fflags,
+            data: 0,
+            udata: std::ptr::null_mut(),
+        };
+        let rc = unsafe {
+            libc::kevent(
+                self.kq,
+                &event,
+                1,
+                std::ptr::null_mut(),
+                0,
+                std::ptr::null(),
+            )
+        };
+        if rc < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(())
+    }
+
+    /// `kevent` wrapper waiting for events.
+    fn wait(&self, events: &mut [libc::kevent]) -> io::Result<usize> {
+        loop {
+            let rc = unsafe {
+                libc::kevent(
+                    self.kq,
+                    std::ptr::null(),
+                    0,
+                    events.as_mut_ptr(),
+                    events.len() as libc::c_int,
+                    std::ptr::null(),
+                )
+            };
+            if rc < 0 {
+                let err = io::Error::last_os_error();
+                if err.kind() == io::ErrorKind::Interrupted {
+                    continue;
+                }
+                return Err(err);
+            }
+            return Ok(rc as usize);
+        }
+    }
+}
+
+/// Actual reactor loop.
+///
+/// With FUSE-T the session fd is a socket, an unmount shows up as `EV_EOF`, which is mapped to
+/// `READY_ERR` like `EPOLLERR` on Linux.
+#[cfg(target_os = "macos")]
+fn poll_thread_inner(poll: Arc<Kqueue>, fd: RawFd, state: Arc<PollState>) -> io::Result<()> {
+    // `EV_CLEAR` makes this edge triggered like `EPOLLET`
+    poll.change(
+        fd as usize,
+        libc::EVFILT_READ,
+        libc::EV_ADD | libc::EV_CLEAR,
+        0,
+    )?;
+
+    // arbitrary buffer size
+    let mut events: [libc::kevent; 8] = unsafe { std::mem::zeroed() };
+
+    'outer: loop {
+        let rc = poll.wait(&mut events)?;
+
+        for event in &events[0..rc] {
+            if event.flags & libc::EV_ERROR != 0 {
+                return Err(io::Error::from_raw_os_error(event.data as i32));
+            }
+
+            match event.filter {
+                // user event got triggered, we just stop at this point
+                libc::EVFILT_USER => break 'outer,
+
+                // fuse fd has something to read, set the ready bits and wake up any waiters
+                libc::EVFILT_READ => {
+                    let eof = event.flags & libc::EV_EOF != 0;
+                    let ready = if eof { READY_IN | READY_ERR } else { READY_IN };
+                    state.ready.fetch_or(ready, Ordering::AcqRel);
+
+                    if eof {
+                        // The fuse file system was unmounted, let's finish up!
+                        break 'outer;
+                    }
+
+                    if let Some(waker) = state.waker.lock().unwrap().take() {
+                        waker.wake();
+                    }
+                }
+                _ => {
+                    return Err(io::Error::other("kevent returned unexpected events"));
+                }
+            }
+        }
+    }
+
+    Ok(())
+}
